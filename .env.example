# Market data provider API (external, API-key authenticated)
DATA_PROVIDER_BASE_URL=https://ow-apis.tapetide.com   # data provider base URL
DATA_PROVIDER_API_KEY=ttr_xxx                          # data provider API key (Secret Manager in prod)

# Vertex AI / Gemini (ADK reads these)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Firestore
FIRESTORE_DATABASE=(default)
